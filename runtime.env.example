# 运行时环境（LLM / Agent / 主动学习反馈选取）。不要提交真实密钥。
# 复制后填写，并限制权限：
#
#   cp runtime.env.example runtime.env
#   chmod 600 runtime.env
#
# 本文件使用 Docker --env-file 兼容格式：KEY=VALUE，行首 # 为注释。
# 项目路径与 project_label/project_desc 仍写在 workflow.ini。

# Provider: DeepSeek / Qwen / Example / HW
LLM_TYPE=DeepSeek

# 可选：覆盖默认模型与 OpenAI-compatible base URL
# DeepSeek 默认: deepseek-chat / https://api.deepseek.com
# Qwen 默认:     qwen3-max   / https://dashscope.aliyuncs.com/compatible-mode/v1
# HW 默认:       auto        / 必须设置 LLM_BASE_URL
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com

# 按 LLM_TYPE 填写对应密钥（Example 不需要）
DEEPSEEK_API_KEY=
# QWEN_API_KEY=
# HW_KEY=

# Agent 轮次
AGENT_MAX_TURNS=128
AGENT_CONCLUSION_RESERVE_TURNS=10

# 主动学习反馈选取：ranking 最前 k + 最后 k + random k（重叠去重）
ACTIVE_LEARNING_FEEDBACK_TOP_K=10
ACTIVE_LEARNING_FEEDBACK_BOTTOM_K=10
ACTIVE_LEARNING_FEEDBACK_RANDOM_K=0
ACTIVE_LEARNING_FEEDBACK_RANDOM_SEED=42
# plain / type
ACTIVE_LEARNING_FEEDBACK_RANDOM_STRATEGY=plain
# 1 = top/bottom 也跳过已有最新分类的警报
ACTIVE_LEARNING_FEEDBACK_SKIP_CLASSIFIED=0

# 主动学习 RGCN 训练（UI / orchestrator 路径读取此处，而非 script/config.env）
ACTIVE_LEARNING_TRAIN_BATCH_SIZE=1
ACTIVE_LEARNING_TRAIN_MAX_UNLABELED=64
ACTIVE_LEARNING_TRAIN_EPOCHS=50
ACTIVE_LEARNING_TRAIN_LR=0.001
ACTIVE_LEARNING_TRAIN_WEIGHT_DECAY=0.0005
ACTIVE_LEARNING_TRAIN_VAL_RATIO=0.2
ACTIVE_LEARNING_TRAIN_PATIENCE=10
ACTIVE_LEARNING_TRAIN_MIN_LABELS=2
ACTIVE_LEARNING_UNCERTAIN_WEIGHT=0.3
ACTIVE_LEARNING_UNLABELED_WEIGHT=0.1
ACTIVE_LEARNING_WEAK_POS=0.7
ACTIVE_LEARNING_WEAK_NEG=0.3
# 按 batch 内节点/边总数上限做图大小感知 batching（0=仅受 BATCH_SIZE 约束）
ACTIVE_LEARNING_TRAIN_MAX_BATCH_NODES=50000
ACTIVE_LEARNING_TRAIN_MAX_BATCH_EDGES=80000

# 可选：非标准工具布局时覆盖默认路径
# SVF_ROOT=
# FPH_ROOT=
# ACTIVE_LEARNING_ROOT=
