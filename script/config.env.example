# 旧 Shell 入口的兼容配置。新工作流优先使用主仓库 workflow.ini.example，
# 其中只保存 bitcode_path/source_dir/artifact_dir 三个条目。
# 复制为 config.env 后修改 bc/out/src 仍可调用兼容包装脚本。
#
#   cp script/config.env.example script/config.env
#
# 主动学习闭环:
#   export PIPELINE_CONFIG="$PWD/script/config.env"   # 或 config.env.falconfs
#   ./script/run_active_learning_loop.sh
#
# 单轮时可用 ROUND_ID=round-001 覆盖默认时间戳 ID。
# 多轮时各轮 ID 为 <前缀>-001、-002 …；前缀默认 round-<UTC时间戳>，也可用 ROUND_ID 或 active_learning_round_prefix 指定。

# ws 默认为 script/ 上级目录，非标准布局时才改
ws="/home/xyc/openEuler分析流程"

bc="$ws/object2_falconfs/bc_linked/falconfs_ex.bc"
out="$ws/output/falconfs_ex"
src="$ws/object2_falconfs/source/FalconFS"

svf_root="$ws/SVFmemplus"
# 空 = 全局本机执行；非空 = SVF + FPhandler + ActiveLearning 均在该镜像容器内执行
docker_name=""
# docker build -f dockerfile.svfmemplus -t SAAA:latest .
# docker_name="SAAA:latest"
defect_types=leak,dfree,uaf,uninit,bof

fph_root="$ws/FPhandler"
active_learning_root="$ws/ActiveLearning"

# 主动学习反馈选取：ranking 最前 k 条（高分）+ 最后 k 条（低分）+
# random k 条未分类警报；重叠自动去重。random_k=0 保持旧行为。
active_learning_feedback_top_k=10
active_learning_feedback_bottom_k=10
active_learning_feedback_random_k=0
active_learning_feedback_random_seed=42
# plain / type；type 会按告警类型轮询抽样，避免 random-k 被大类垄断
active_learning_feedback_random_strategy=plain
# 1 = top/bottom 也跳过已有最新分类的警报，把预算留给新样本
active_learning_feedback_skip_classified=0

# 一次执行连续跑几轮反馈循环（SVF 与图导出仅首轮；每轮重排、反馈、训练并归档产物）
active_learning_rounds=10
# 多轮时各轮 ID 前缀；留空则用 round-<UTC时间戳>（也可用环境变量 ROUND_ID 覆盖）
# active_learning_round_prefix=round-20260717T120000Z

# 初始模型权重（可选）
# - 留空：若 checkpoints/latest.pt 存在则加载，否则本轮 predict 使用随机权重
# - 填路径：本轮 predict / train warm-start 从该权重加载
active_learning_model_path=""
# checkpoint 目录（每轮反馈后训练写入 <round_id>.pt 与 latest.pt）
# 相对路径相对于 out/
active_learning_checkpoint_dir="active_learning/checkpoints"
active_learning_train_epochs=50
active_learning_train_lr=0.001
active_learning_train_weight_decay=0.0005
active_learning_train_batch_size=8
active_learning_train_val_ratio=0.2
active_learning_train_patience=10
# 至少需要这么多 TP/FP 硬标签才开训；单侧（仅 FP 或仅 TP）可用弱监督训练
active_learning_train_min_labels=2
# 弱监督：UNCERTAIN 软标签权重；单侧时未标注图的弱正/弱负权重与目标
active_learning_uncertain_weight=0.3
active_learning_unlabeled_weight=0.1
active_learning_weak_pos=0.7
active_learning_weak_neg=0.3
active_learning_max_unlabeled=512
active_learning_train_max_batch_nodes=50000
active_learning_train_max_batch_edges=80000

llm_type="DeepSeek"
project_label="my-run"
project_desc=""
agent_max_turns=128
agent_conclusion_reserve_turns=10

# LLM API Key（按 llm_type 填写对应项）
#   DeepSeek -> deepseek_api_key
#   Qwen     -> qwen_api_key
#   Example  -> 离线烟测后端，不需要 key（会产生 UNCERTAIN 占位，勿用于正式训练）
#   HW       -> hw_key
deepseek_api_key=""
qwen_api_key=""
example_key=""
hw_key=""

# 项目 semantic-fact/v2；留空时默认为 $out/semantic_facts.json。
semantic_rules=""
