# 复制为 config.env 后修改 bc/out/src 即可切换被测对象
#
#   cp script/config.env.example script/config.env

# ws 默认为 script/ 上级目录，非标准布局时才改
ws="/home/xyc/openEuler分析流程"

bc="$ws/object2_falconfs/bc_linked/falconfs_ex.bc"
out="$ws/output/falconfs_ex"
src="$ws/object2_falconfs/source/FalconFS"

svf_root="$ws/SVFmemplus"
svf_docker_image="nf-image:llvm21"
svf_mode="docker"
defect_types=leak,dfree,uaf,uninit

fph_root="$ws/FPhandler"
llm_type="DeepSeek"
project_label="my-run"
project_desc=""

# LLM API Key（按 llm_type 填写对应项）
#   DeepSeek -> deepseek_api_key
#   Qwen     -> qwen_api_key
#   Example  -> example_key
#   HW       -> hw_key
deepseek_api_key=""
qwen_api_key=""
example_key=""
hw_key=""

semantic_rules=""
